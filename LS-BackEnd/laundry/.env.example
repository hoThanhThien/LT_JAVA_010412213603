# ===========================================
# Server & JPA (Optional - defaults in application.properties)
# Copy this file to .env in LS-BackEnd/laundry/ for local development
# ===========================================
SERVER_PORT=8080
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update
APP_LOG_LEVEL=DEBUG

# ===========================================
# Database (MySQL / MariaDB)
# ===========================================
DB_URL=jdbc:mysql://localhost:3306/laundry?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=

# ===========================================
# Security / JWT (Must match frontend JWT_SECRET)
# ===========================================
JWT_SECRET=change-me-use-a-long-random-secret
JWT_ACCESS_DURATION=1800000
JWT_REFRESH_DURATION=604800000

# ===========================================
# Mail (SMTP)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===========================================
# Firebase Admin SDK
# ===========================================
FIREBASE_CONFIG_PATH=firebase-service-account.json

# ===========================================
# Payment (Casso & VietQR)
# ===========================================
CASSO_BASE_URL=https://oauth.casso.vn/v2/transactions
CASSO_POLLING_INTERVAL_MS=35000
CASSO_API_KEY=your-casso-api-key

VIET_QR_URL=https://img.vietqr.io/image
BANK_ACCOUNT_HOLDER=NGUYEN VAN A
BANK_ACCOUNT_NUMBER=0123456789
